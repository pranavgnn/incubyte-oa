# Copy to apps/api/.env and fill in. Every key in src/config/env-schema.ts is listed here.

# development | test | production (default: development)
NODE_ENV=development
# default: 3000
PORT=3000

# Matches the `db` service in compose.yaml
DATABASE_URL=postgres://dealership:dealership@localhost:5432/dealership
# Matches the `db-test` service. Must differ from DATABASE_URL; tests truncate it.
TEST_DATABASE_URL=postgres://dealership:dealership@localhost:5433/dealership_test

# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# default: 15m
JWT_EXPIRES_IN=15m

# Origin of the web app, used for CORS
WEB_ORIGIN=http://localhost:5173
